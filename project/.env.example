# TradeOS — Environment Variables
# Copy to .env and fill in values

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=P@ss1234
POSTGRES_DB=tradeos

# Redis
REDIS_PASSWORD=

# JWT
JWT_KEY=TRADEOS_DEFAULT_DEV_SECRET_CHANGE_IN_PROD_32CHARS!
JWT_ISSUER=TradeOS

# Python sidecar internal URL (C# → Python)
PYTHON_BASE_URL=http://tradeos-python:8000

# Frontend origin (CORS)
CORS_ORIGIN=http://localhost:3000
